pipeline {
    agent any
    tools {
        maven 'M2_HOME'  // Assurez-vous que Maven est installé
    }
    environment {
        SONARQUBE_URL = 'http://localhost:9000'  // URL de votre serveur SonarQube
        SONARQUBE_TOKEN = credentials('sonar-token')  // Vous pouvez configurer ce token sous Jenkins Credentials
    }
    stages {
        stage('GIT') {
            steps {
                git branch: 'shiraz_msalmi_kaddem2',
                    url: 'git@github.com:turkiahmed11/DevopsProject.git',
                    credentialsId: 'jenkins-example-github-pat'
            }
        }
        stage('Clean and Compile') {
            steps {
                script {
                    sh 'mvn clean compile'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                script {
                    // Exécute la commande Maven pour analyser le code avec SonarQube
                    sh """
                        mvn sonar:sonar \
                            -Dsonar.projectKey=my-project-key \
                            -Dsonar.host.url=${env.SONARQUBE_URL} \
                            -Dsonar.login=${env.SONARQUBE_TOKEN}
                    """
                }
            }
        }
    }
}
